{
  "schema": "geometry-baker/projection-rules/v1",
  "conventions": {
    "cage": "p_outer = p + N * outerDistance; p_inner = p - N * innerDistance",
    "rayDirection": "inner_to_outer",
    "rayDirectionFormula": "normalize(cageOuterPoint - cageInnerPoint)",
    "projectionFacing": "dot(hit.geometricNormal, rayDirection) >= 0",
    "projectionFacingNote": "This is source-normal alignment with outward projection, not the ray-origin side used by real-time face culling.",
    "exampleWinding": "shell_outer normals point radially outward; shell_inner normals face the cavity/axis and therefore align negatively with the outward ray.",
    "tangentNormal": "OpenGL-style +Z neutral; RGB = xyz * 0.5 + 0.5",
    "tangentMatrix": "worldToTangent is column-major and M.mulVec yields dot(T/B/N, worldVector)",
    "uvTexelRow": "buffer/py 0 is v=0 in this baker and its software renderer"
  },
